# Copy to .env and change every value marked CHANGE_ME.

# --- PostgreSQL ---
POSTGRES_USER=campusfind
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=campusfind
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
ENVIRONMENT=development
# Host "db" resolves inside docker compose. For running the backend on your host use localhost.
DATABASE_URL=postgresql+psycopg://campusfind:CHANGE_ME@db:5432/campusfind
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Max image upload size in MB
MAX_UPLOAD_MB=15

# --- Demo seed data (development only; set SEED_DEMO_DATA=false in any real deployment) ---
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@campusfind.edu
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_DEMO_PASSWORD=CHANGE_ME

# --- Frontend (build-time, public) ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api
